{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASMacro",
  "version": "1.0.2",
  "identifier": "me.asmek.asmacro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ASMacro",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://github.com https://objects.githubusercontent.com https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "fileAssociations": [
      {
        "ext": ["asmacro"],
        "name": "ASMacro.macro",
        "description": "ASMacro macro",
        "role": "Editor",
        "mimeType": "application/x-asmacro"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Polish"],
        "displayLanguageSelector": true,
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "tesseract-ocr",
          "tesseract-ocr-eng",
          "xdg-desktop-portal"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-asmacro.rules": "linux/60-asmacro.rules"
        }
      },
      "rpm": {
        "depends": [
          "tesseract",
          "tesseract-langpack-eng",
          "xdg-desktop-portal"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-asmacro.rules": "linux/60-asmacro.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQUU1MDFGREMxQkM1NzUKUldSMXhSdmNIMUN1MzYxSGVsRlJZM3dQNU84eEl2ZEhROEZzeHRlQktyalB3c0plbUhaV2RVOXMK",
      "endpoints": [
        "https://github.com/AsmekYT/ASMacro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
